#!/bin/bash

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# ran the tool's normal actions. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-agents - Front door to AI agents: explains Hermes vs OpenClaw and launches one.

USAGE
  shadowfetch-agents       compare the agents and pick one

WHAT IT DOES
  Checks prerequisites and hands off to shadowfetch-hermes or
  shadowfetch-openclaw, either of which downloads an installer.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-agents (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac
# shadowfetch-agents - the front door to AI agents on Shadowfetch Linux.
# Explains the choice (Hermes vs OpenClaw), confirms prerequisites, and launches
# whichever you pick. Everything runs on-device; cloud providers are optional.
say()  { printf '\033[1;33m%s\033[0m\n' "$*"; }
gold() { printf '\033[1;33m%s\033[0m' "$*"; }
info() { printf '  %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Brand mark, traced from usr/share/icons/hicolor/scalable/apps/shadowfetch.svg
# (hexagon #D8A24A, dot #E8B65E, chevron). ANSI only: the ISO ships no ASCII-art
# renderer and Konsole has no kitty graphics protocol, so this needs nothing.
# ---------------------------------------------------------------------------
sf_logo() {
    local G D R
    if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
        case "${COLORTERM:-}" in
            truecolor|24bit) G=$'[38;2;216;162;74m'; D=$'[38;2;232;182;94m' ;;
            *)               G=$'[38;5;179m';        D=$'[38;5;222m' ;;
        esac
        R=$'[0m'
    else
        G=""; D=""; R=""
    fi
    printf '
'
    printf '   %s    /\    %s
' "$G" "$R"
    printf '   %s   /  \   %s
' "$G" "$R"
    printf '   %s  /    \  %s
' "$G" "$R"
    printf '   %s /  %s()%s  \ %s
' "$G" "$D" "$G" "$R"
    printf '   %s|        |%s
' "$G" "$R"
    printf '   %s| \    / |%s
' "$G" "$R"
    printf '   %s|  \  /  |%s
' "$G" "$R"
    printf '   %s \  \/  / %s
' "$G" "$R"
    printf '   %s  \    /  %s
' "$G" "$R"
    printf '   %s   \  /   %s
' "$G" "$R"
    printf '   %s    \/    %s
' "$G" "$R"
    printf '
'
    printf '     %sS H A D O W F E T C H%s
' "$G" "$R"
    printf '       %s%s%s
' "$D" "$1" "$R"
    printf '
'
}

ok()   { printf '  \033[1;32m%s\033[0m %s\n' "ok" "$*"; }
no()   { printf '  \033[1;31m%s\033[0m %s\n' "--" "$*"; }

clear 2>/dev/null
sf_logo "Agent Ready"
echo
say "Prerequisites (Shadowfetch ships these for you):"
for tuple in "node:Node.js (for OpenClaw)" "npm:npm" "python3:Python 3 (for Hermes)" "git:git" "curl:curl" "rg:ripgrep" "ffmpeg:ffmpeg"; do
    bin="${tuple%%:*}"; desc="${tuple#*:}"
    if command -v "$bin" >/dev/null 2>&1; then ok "$desc"; else no "$desc (missing)"; fi
done
echo
say "Choose your agent:"
echo
printf "  $(gold '1) Hermes Agent')   -  Nous Research\n"
info "     Self-improving: writes its own skills from what you do. One agent,"
info "     many profiles, a messaging gateway (Telegram/Discord/Slack/...)."
info "     Best if you want a powerful agent that grows with you."
echo
printf "  $(gold '2) OpenClaw')       -  open personal agent\n"
info "     Lightweight, npm-installed, friendly onboarding. Drives your local"
info "     Ollama models out of the box. Best for a quick, simple start."
echo
printf "  $(gold '3) Local model only')  -  no agent, just a private LLM\n"
info "     Pick a Hugging Face model matched to your hardware and chat locally."
echo
printf "  $(gold '4) Agent Studio')      -  isolated project workspaces\n"
info "     Create a clean workspace with task state, durable memory, artifacts,"
info "     safe defaults, and an optional matching Hermes profile."
echo
printf "  $(gold '5) Tools & doctor')    -  browser, sandbox and health setup\n"
info "     Enable browser automation deliberately and audit local agent exposure."
echo
info "  q) Quit"
echo
printf "Your choice [1/2/3/4/5/q]: "; read choice
case "$choice" in
    1) exec shadowfetch-hermes ;;
    2) exec shadowfetch-openclaw ;;
    3) exec shadowfetch-llm ;;
    4) exec shadowfetch-agent-workspace ;;
    5) exec shadowfetch-agent-tools ;;
    q|Q|"") echo; info "No problem - run 'shadowfetch-agents' any time, or open"; info "'Choose AI Agent' from the application menu."; exit 0 ;;
    *) echo; no "Unrecognized choice."; exit 1 ;;
esac
