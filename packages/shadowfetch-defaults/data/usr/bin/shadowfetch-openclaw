#!/bin/bash
# shadowfetch-openclaw - install, update, then launch OpenClaw onboarding.
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# began downloading and running a remote installer. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-openclaw - Install, update and launch OpenClaw onboarding.

USAGE
  shadowfetch-openclaw     install or update, then start onboarding

WHAT IT DOES
  DOWNLOADS AND RUNS the official OpenClaw installer. Needs Node 22.19+,
  23.11+ or 24+; it will tell you if the version is too old.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-openclaw (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

say()  { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '  \033[1;31m%s\033[0m %s\n' "--" "$*"; }

SELF="${BASH_SOURCE[0]}"
if [[ ! -t 0 && -z "${SHADOWFETCH_AGENT_TERMINAL:-}" && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    if command -v konsole >/dev/null 2>&1; then
        exec konsole --hold -e bash -lc "export SHADOWFETCH_AGENT_TERMINAL=1; exec '$SELF'"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec x-terminal-emulator -e bash -lc "export SHADOWFETCH_AGENT_TERMINAL=1; exec '$SELF'"
    elif command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal -- bash -lc "export SHADOWFETCH_AGENT_TERMINAL=1; exec '$SELF'; read -r -p 'Press Enter to close...'"
    fi
fi

export PATH="$HOME/.local/bin:$HOME/.openclaw/bin:/usr/local/bin:$PATH"

node_ok() {
    command -v node >/dev/null 2>&1 || return 1
    node -e '
const [maj, min] = process.versions.node.split(".").map(Number);
process.exit((maj >= 24 || (maj === 23 && min >= 11) || (maj === 22 && min >= 19)) ? 0 : 1);
'
}

ensure_user_npm_prefix() {
    mkdir -p "$HOME/.local/bin"
    local prefix
    prefix="$(npm config get prefix 2>/dev/null || true)"
    if [[ -z "$prefix" || ! -w "$prefix" ]]; then
        npm config set prefix "$HOME/.local"
    fi
    export PATH="$HOME/.local/bin:$PATH"
}

install_with_openclaw_installer() {
    say "Installing OpenClaw with the official installer..."
    curl -fsSL https://openclaw.ai/install.sh | bash -s -- --no-onboard
}

install_with_npm() {
    say "Installing OpenClaw from npm into your user account..."
    ensure_user_npm_prefix
    npm install -g openclaw@latest
}

if ! node_ok; then
    warn "OpenClaw needs Node 22.19+, 23.11+, or 24+. Running the official installer."
    install_with_openclaw_installer
elif command -v openclaw >/dev/null 2>&1; then
    say "OpenClaw is installed. Updating to the latest stable release..."
    openclaw update --channel stable || install_with_npm || install_with_openclaw_installer
else
    install_with_npm || install_with_openclaw_installer
fi

export PATH="$HOME/.local/bin:$HOME/.openclaw/bin:/usr/local/bin:$PATH"

if ! command -v openclaw >/dev/null 2>&1; then
    warn "OpenClaw did not land on PATH."
    info "Open a new terminal, or run: export PATH=\"\$HOME/.local/bin:\$HOME/.openclaw/bin:\$PATH\""
    exit 1
fi

say "Opening OpenClaw onboarding. Choose Ollama during setup for a fully local agent."
exec openclaw onboard --install-daemon
