#!/usr/bin/env python3
"""Shadowfetch Assistant — a graceful, local-first agentic front door.

Everything here talks only to the machine in front of you: it sets up the
private on-device AI stack (Ollama, optionally Open-WebUI), chats with the
local model over 127.0.0.1, and runs guided setup recipes — all with in-app
progress, never a raw terminal. No account, no cloud, no telemetry.
"""

from __future__ import annotations

# ---- --help / --version, BEFORE any other import ----------------------------
# Deliberately above the Qt import: this is a GUI tool, and importing PyQt6
# first would make `--help` die with an import error on a headless machine
# instead of printing anything. Until 2026-07-26 there was no argument handling
# here at all.
import os as _sfsos
import sys as _sfsys
if any(_a in ("-h", "--help") for _a in _sfsys.argv[1:]):
    print("""shadowfetch-assistant - Local-first assistant: sets up on-device AI and answers questions about the system.

USAGE
  shadowfetch-assistant    open the assistant

WHAT IT DOES
  Talks only to this machine. Setup actions it offers may download model
  runtimes; it asks first.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/""")
    raise SystemExit(0)
if "--version" in _sfsys.argv[1:]:
    print("shadowfetch-assistant (Shadowfetch Linux) " + (open("/usr/share/shadowfetch/version").read().strip() if _sfsos.path.exists("/usr/share/shadowfetch/version") else "unknown"))
    raise SystemExit(0)

import json
import os
import shutil
import subprocess
import urllib.request
from pathlib import Path

from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtGui import QFont, QIcon
from PyQt6.QtWidgets import (
    QApplication, QComboBox, QFrame, QHBoxLayout, QLabel, QLineEdit,
    QMainWindow, QProgressBar, QPushButton, QScrollArea, QSizePolicy,
    QStackedWidget, QTextEdit, QVBoxLayout, QWidget,
)

GOLD = "#D8A24A"
GOLD_HI = "#E8B65E"
BG = "#0B0E12"
CARD = "#141922"
BORDER = "#2C333B"
TEXT = "#E6E9ED"
MUTED = "#9AA3AD"
OLLAMA = "http://127.0.0.1:11434"


def sf_version() -> str:
    try:
        return Path("/usr/share/shadowfetch/version").read_text().strip()
    except Exception:
        return "2.0.1"


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def sh(args, timeout=8):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Hardware / AI status probes (all fail-safe)                                  #
# --------------------------------------------------------------------------- #
def ram_gb() -> int:
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return round(int(line.split()[1]) / 1024 / 1024)
    except Exception:
        pass
    return 0


def gpu_desc() -> str:
    r = sh(["nvidia-smi", "--query-gpu=name,memory.total", "--format=csv,noheader"])
    if r and r.returncode == 0 and r.stdout.strip():
        return "NVIDIA " + r.stdout.strip().splitlines()[0].strip()
    r = sh(["lspci"])
    if r and r.returncode == 0:
        for line in r.stdout.splitlines():
            low = line.lower()
            if " vga " in low or "3d controller" in low or "display controller" in low:
                return line.split(": ", 1)[-1].strip()
    return "Unknown GPU"


def vram_gb() -> int:
    r = sh(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"])
    if r and r.returncode == 0 and r.stdout.strip():
        try:
            return round(int(r.stdout.strip().splitlines()[0]) / 1024)
        except Exception:
            return 0
    return 0


def recommended_model() -> str:
    if os.environ.get("SHADOWFETCH_AI_MODEL"):
        return os.environ["SHADOWFETCH_AI_MODEL"]
    v, r = vram_gb(), ram_gb()
    if v >= 16 or r >= 32:
        return "gemma3:12b"
    if v >= 8 or r >= 16:
        return "gemma3:4b"
    return "llama3.2:3b"


def ollama_running() -> bool:
    try:
        with urllib.request.urlopen(OLLAMA + "/api/version", timeout=1.5):
            return True
    except Exception:
        return False


def local_models() -> list[str]:
    try:
        with urllib.request.urlopen(OLLAMA + "/api/tags", timeout=2) as resp:
            data = json.load(resp)
        return [m["name"] for m in data.get("models", [])]
    except Exception:
        return []


# --------------------------------------------------------------------------- #
# Workers                                                                       #
# --------------------------------------------------------------------------- #
class CommandWorker(QThread):
    """Run a shell pipeline, streaming stdout/stderr lines to the UI."""
    line = pyqtSignal(str)
    done = pyqtSignal(int)

    def __init__(self, argv):
        super().__init__()
        self.argv = argv

    def run(self):
        try:
            p = subprocess.Popen(self.argv, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, bufsize=1)
        except Exception as e:  # noqa: BLE001
            self.line.emit(f"error: {e}")
            self.done.emit(1)
            return
        for ln in iter(p.stdout.readline, ""):
            self.line.emit(ln.rstrip("\n"))
        p.stdout.close()
        self.done.emit(p.wait())


class ChatWorker(QThread):
    """Stream a chat completion from the local Ollama model."""
    chunk = pyqtSignal(str)
    done = pyqtSignal(bool)

    def __init__(self, model, messages):
        super().__init__()
        self.model = model
        self.messages = messages

    def run(self):
        body = json.dumps({"model": self.model, "messages": self.messages,
                           "stream": True}).encode()
        req = urllib.request.Request(OLLAMA + "/api/chat", data=body,
                                     headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                for raw in resp:
                    raw = raw.strip()
                    if not raw:
                        continue
                    try:
                        obj = json.loads(raw)
                    except Exception:
                        continue
                    self.chunk.emit(obj.get("message", {}).get("content", ""))
                    if obj.get("done"):
                        break
            self.done.emit(True)
        except Exception as e:  # noqa: BLE001
            self.chunk.emit(f"\n[local model unavailable: {e}]")
            self.done.emit(False)


# --------------------------------------------------------------------------- #
# UI helpers                                                                    #
# --------------------------------------------------------------------------- #
def card(widget: QWidget) -> QFrame:
    f = QFrame()
    f.setObjectName("card")
    lay = QVBoxLayout(f)
    lay.setContentsMargins(18, 16, 18, 16)
    lay.addWidget(widget)
    return f


def button(text, primary=False) -> QPushButton:
    b = QPushButton(text)
    b.setCursor(Qt.CursorShape.PointingHandCursor)
    b.setObjectName("primary" if primary else "ghost")
    b.setMinimumHeight(38)
    return b


# --------------------------------------------------------------------------- #
# Pages                                                                         #
# --------------------------------------------------------------------------- #
class HomePage(QWidget):
    def __init__(self, app):
        super().__init__()
        self.app = app
        root = QVBoxLayout(self)
        root.setContentsMargins(28, 24, 28, 24)
        root.setSpacing(14)

        title = QLabel("Your machine")
        title.setObjectName("h1")
        root.addWidget(title)
        self.hw = QLabel("…")
        self.hw.setObjectName("body")
        self.hw.setWordWrap(True)
        root.addWidget(card(self.hw))

        title2 = QLabel("Private on-device AI")
        title2.setObjectName("h1")
        root.addWidget(title2)
        self.ai = QLabel("…")
        self.ai.setObjectName("body")
        self.ai.setWordWrap(True)
        root.addWidget(card(self.ai))

        row = QHBoxLayout()
        self.setup_btn = button("Set up private AI", primary=True)
        self.setup_btn.clicked.connect(self.app.run_ai_setup)
        self.chat_btn = button("Open chat")
        self.chat_btn.clicked.connect(lambda: self.app.stack.setCurrentIndex(1))
        row.addWidget(self.setup_btn)
        row.addWidget(self.chat_btn)
        row.addStretch(1)
        root.addLayout(row)
        root.addStretch(1)
        self.refresh()

    def refresh(self):
        r, g, v = ram_gb(), gpu_desc(), vram_gb()
        self.hw.setText(
            f"<b>{r} GB</b> RAM  ·  {g}" + (f"  ·  <b>{v} GB</b> VRAM" if v else ""))
        running = ollama_running()
        models = local_models()
        rec = recommended_model()
        if not have("ollama") and not running:
            self.ai.setText("Not set up yet. Ollama is installed on demand — it runs "
                            "fully local, bound to 127.0.0.1, firewalled from the LAN.<br>"
                            f"Recommended model for this hardware: <b>{rec}</b>.")
            self.setup_btn.setEnabled(True)
        elif running and models:
            self.ai.setText(f"Ready. Ollama is running with {len(models)} local "
                            f"model(s): <b>{', '.join(models)}</b>.")
            self.setup_btn.setText("Add another model")
        else:
            self.ai.setText("Ollama is installed but no model is present yet.<br>"
                            f"Recommended for this hardware: <b>{rec}</b>.")


class ChatPage(QWidget):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.history = [{"role": "system",
                         "content": "You are the Shadowfetch Assistant, a concise, "
                         "privacy-respecting local helper running on Shadowfetch Linux."}]
        self.worker = None
        root = QVBoxLayout(self)
        root.setContentsMargins(28, 24, 28, 24)
        root.setSpacing(10)

        top = QHBoxLayout()
        h = QLabel("Local chat")
        h.setObjectName("h1")
        top.addWidget(h)
        top.addStretch(1)
        self.model_box = QComboBox()
        top.addWidget(QLabel("Model:"))
        top.addWidget(self.model_box)
        root.addLayout(top)

        self.view = QTextEdit()
        self.view.setReadOnly(True)
        self.view.setObjectName("chat")
        root.addWidget(self.view, 1)

        row = QHBoxLayout()
        self.entry = QLineEdit()
        self.entry.setPlaceholderText("Ask the local model…")
        self.entry.returnPressed.connect(self.send)
        self.send_btn = button("Send", primary=True)
        self.send_btn.clicked.connect(self.send)
        row.addWidget(self.entry, 1)
        row.addWidget(self.send_btn)
        root.addLayout(row)

    def showEvent(self, e):
        super().showEvent(e)
        cur = self.model_box.currentText()
        self.model_box.clear()
        models = local_models()
        self.model_box.addItems(models or [recommended_model()])
        if cur:
            i = self.model_box.findText(cur)
            if i >= 0:
                self.model_box.setCurrentIndex(i)
        if not ollama_running():
            self.view.append("<i style='color:%s'>The local model isn't running yet. "
                             "Use “Set up private AI” on the Home tab first.</i>" % MUTED)

    def send(self):
        text = self.entry.text().strip()
        if not text or (self.worker and self.worker.isRunning()):
            return
        model = self.model_box.currentText() or recommended_model()
        self.entry.clear()
        self.history.append({"role": "user", "content": text})
        self.view.append(f"<b style='color:{GOLD_HI}'>You</b><br>{text}<br>")
        self.view.append(f"<b style='color:{GOLD}'>Assistant</b><br>")
        self._acc = ""
        self.send_btn.setEnabled(False)
        self.worker = ChatWorker(model, list(self.history))
        self.worker.chunk.connect(self._on_chunk)
        self.worker.done.connect(self._on_done)
        self.worker.start()

    def _on_chunk(self, c):
        self._acc += c
        self.view.moveCursor(self.view.textCursor().MoveOperation.End)
        self.view.insertPlainText(c)

    def _on_done(self, ok):
        if ok and self._acc:
            self.history.append({"role": "assistant", "content": self._acc})
        self.view.append("<br>")
        self.send_btn.setEnabled(True)


class RecipesPage(QWidget):
    RECIPES = [
        ("Private AI web chat", "Open-WebUI — a ChatGPT-style interface for your "
         "local models, localhost-only.", ["shadowfetch-ai", "webui"]),
        ("Pick a different model", "Browse hardware-matched local models and pull one.",
         ["shadowfetch-llm"]),
        ("Agent workspace", "Scaffold a new agent project (AGENTS.md, tasks, memory).",
         ["shadowfetch-agent-workspace"]),
        ("Set up an agent runtime", "Install Hermes or OpenClaw, guided.",
         ["shadowfetch-agents"]),
        ("System health report", "Full local health check (services, disk, updates).",
         ["shadowfetch-health"]),
    ]

    def __init__(self, app):
        super().__init__()
        self.app = app
        root = QVBoxLayout(self)
        root.setContentsMargins(28, 24, 28, 24)
        root.setSpacing(12)
        h = QLabel("Guided recipes")
        h.setObjectName("h1")
        root.addWidget(h)
        for name, desc, argv in self.RECIPES:
            f = QFrame()
            f.setObjectName("card")
            lay = QHBoxLayout(f)
            lay.setContentsMargins(18, 12, 18, 12)
            col = QVBoxLayout()
            t = QLabel(name)
            t.setObjectName("h2")
            d = QLabel(desc)
            d.setObjectName("muted")
            d.setWordWrap(True)
            col.addWidget(t)
            col.addWidget(d)
            lay.addLayout(col, 1)
            b = button("Run")
            b.clicked.connect(lambda _, a=argv, n=name: self.app.run_recipe(n, a))
            lay.addWidget(b, 0, Qt.AlignmentFlag.AlignVCenter)
            root.addWidget(f)
        root.addStretch(1)


# --------------------------------------------------------------------------- #
# Main window                                                                   #
# --------------------------------------------------------------------------- #
class Assistant(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Shadowfetch Assistant")
        self.setWindowIcon(QIcon.fromTheme("shadowfetch"))
        self.resize(960, 680)
        self.setMinimumSize(820, 560)

        central = QWidget()
        self.setCentralWidget(central)
        outer = QHBoxLayout(central)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # sidebar
        side = QWidget()
        side.setObjectName("side")
        side.setFixedWidth(210)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(16, 22, 16, 22)
        sl.setSpacing(6)
        brand = QLabel("Shadowfetch\nAssistant")
        brand.setObjectName("brand")
        sl.addWidget(brand)
        ver = QLabel(f"Umbra · {sf_version()}")
        ver.setObjectName("muted")
        sl.addWidget(ver)
        sl.addSpacing(18)
        self.nav = []
        for i, name in enumerate(("Home", "Chat", "Recipes")):
            b = QPushButton(name)
            b.setObjectName("nav")
            b.setCheckable(True)
            b.setCursor(Qt.CursorShape.PointingHandCursor)
            b.clicked.connect(lambda _, ix=i: self.select(ix))
            sl.addWidget(b)
            self.nav.append(b)
        sl.addStretch(1)
        note = QLabel("Runs fully offline.\nNo account. No telemetry.")
        note.setObjectName("muted")
        sl.addWidget(note)
        outer.addWidget(side)

        # content stack + log
        right = QVBoxLayout()
        right.setContentsMargins(0, 0, 0, 0)
        self.stack = QStackedWidget()
        self.home = HomePage(self)
        self.chat = ChatPage(self)
        self.recipes = RecipesPage(self)
        for p in (self.home, self.chat, self.recipes):
            self.stack.addWidget(p)
        right.addWidget(self.stack, 1)

        self.log = QTextEdit()
        self.log.setReadOnly(True)
        self.log.setObjectName("log")
        self.log.setFixedHeight(0)
        self.progress = QProgressBar()
        self.progress.setObjectName("bar")
        self.progress.setRange(0, 0)
        self.progress.hide()
        right.addWidget(self.progress)
        right.addWidget(self.log)
        w = QWidget()
        w.setLayout(right)
        outer.addWidget(w, 1)

        self.select(0)
        self._cmd = None
        self._apply_style()

    def select(self, ix):
        self.stack.setCurrentIndex(ix)
        for i, b in enumerate(self.nav):
            b.setChecked(i == ix)
        if ix == 0:
            self.home.refresh()

    # -- long-running commands with in-app progress ------------------------- #
    def _start(self, argv, title):
        if self._cmd and self._cmd.isRunning():
            return
        self.log.setFixedHeight(190)
        self.log.clear()
        self.log.append(f"<b style='color:{GOLD}'>{title}</b>")
        self.progress.show()
        self._cmd = CommandWorker(argv)
        self._cmd.line.connect(lambda ln: self.log.append(ln))
        self._cmd.done.connect(lambda rc: self._finished(rc, title))
        self._cmd.start()

    def _finished(self, rc, title):
        self.progress.hide()
        ok = rc == 0
        self.log.append(f"<b style='color:{'#7bd88f' if ok else '#e06c75'}'>"
                        f"{'✓ done' if ok else '✗ exited ' + str(rc)}</b>")
        self.home.refresh()

    def run_ai_setup(self):
        self._start(["shadowfetch-ai", "setup"], "Setting up private local AI…")

    def run_recipe(self, name, argv):
        # GUI-style recipes launch their own window; CLI ones stream in-app.
        gui = argv[0] in ("shadowfetch-agent-workspace",)
        if gui or not have(argv[0]):
            try:
                subprocess.Popen(argv)
                self.log.setFixedHeight(120)
                self.log.append(f"Launched {name}.")
            except Exception as e:  # noqa: BLE001
                self.log.setFixedHeight(120)
                self.log.append(f"Could not launch {name}: {e}")
            return
        self._start(argv, f"{name}…")

    def _apply_style(self):
        self.setStyleSheet(f"""
            QWidget {{ background:{BG}; color:{TEXT};
                       font-family:'Inter','Noto Sans',sans-serif; font-size:14px; }}
            #side {{ background:#0E1218; border-right:1px solid {BORDER}; }}
            #brand {{ color:{GOLD}; font-size:18px; font-weight:700; }}
            #h1 {{ font-size:20px; font-weight:700; color:{TEXT}; }}
            #h2 {{ font-size:15px; font-weight:600; color:{TEXT}; }}
            #body {{ font-size:14px; color:{TEXT}; }}
            #muted {{ color:{MUTED}; font-size:12px; }}
            #card {{ background:{CARD}; border:1px solid {BORDER}; border-radius:10px; }}
            QPushButton#nav {{ text-align:left; padding:9px 12px; border:none;
                       border-radius:8px; color:{MUTED}; background:transparent; }}
            QPushButton#nav:checked {{ color:{TEXT}; background:{CARD}; }}
            QPushButton#nav:hover {{ color:{TEXT}; }}
            QPushButton#primary {{ background:{GOLD}; color:#1a1206; border:none;
                       border-radius:9px; padding:8px 18px; font-weight:600; }}
            QPushButton#primary:hover {{ background:{GOLD_HI}; }}
            QPushButton#primary:disabled {{ background:{BORDER}; color:{MUTED}; }}
            QPushButton#ghost {{ background:transparent; color:{TEXT};
                       border:1px solid {BORDER}; border-radius:9px; padding:8px 18px; }}
            QPushButton#ghost:hover {{ border-color:{GOLD}; }}
            QTextEdit#chat, QTextEdit#log {{ background:{CARD}; border:1px solid {BORDER};
                       border-radius:10px; padding:10px; }}
            QLineEdit, QComboBox {{ background:{CARD}; border:1px solid {BORDER};
                       border-radius:9px; padding:8px 10px; color:{TEXT}; }}
            QProgressBar#bar {{ background:{CARD}; border:1px solid {BORDER};
                       border-radius:6px; height:6px; }}
            QProgressBar#bar::chunk {{ background:{GOLD}; border-radius:6px; }}
        """)


def main():
    app = QApplication([])
    app.setApplicationName("Shadowfetch Assistant")
    font = QFont("Inter")
    app.setFont(font)
    win = Assistant()
    win.show()
    app.exec()


if __name__ == "__main__":
    main()
