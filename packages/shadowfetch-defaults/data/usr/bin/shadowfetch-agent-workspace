#!/bin/bash
# Create and operate isolated, documented workspaces for local agents.
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# ran the tool's normal actions. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-agent-workspace - Create and operate isolated, documented agent workspaces.

USAGE
  shadowfetch-agent-workspace              list workspaces
  shadowfetch-agent-workspace new NAME     create one

WHAT IT DOES
  Workspaces live under ~/Agent Workspaces (override with
  SHADOWFETCH_AGENT_WORKSPACES). Each gets its own instructions, tasks
  and safety rules.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-agent-workspace (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

ROOT="${SHADOWFETCH_AGENT_WORKSPACES:-$HOME/Agent Workspaces}"
mkdir -p "$ROOT"
chmod 700 "$ROOT"

say() { printf '\n\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
die() { printf '  \033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }

sanitize() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//' | cut -c1-48
}

create_workspace() {
    local requested="${1:-}"
    [[ -n "$requested" ]] || read -r -p "Workspace name: " requested
    local name
    name=$(sanitize "$requested")
    [[ -n "$name" ]] || die "Use letters, numbers, dots, dashes or underscores."
    local workspace="$ROOT/$name"
    [[ ! -e "$workspace" ]] || die "Workspace already exists: $workspace"
    mkdir -p "$workspace"/{artifacts,logs,scratch,skills}
    chmod 700 "$workspace"

    cat >"$workspace/AGENTS.md" <<EOF
# $requested

## Mission

Describe the outcome this workspace exists to produce.

## Operating rules

- Read this file and TASKS.md before acting.
- Keep work inside this workspace unless explicitly authorized.
- Never place passwords, API keys, tokens, private keys, or recovery codes in project files.
- Ask before publishing, purchasing, deleting, messaging, or changing external systems.
- Record durable decisions in MEMORY.md and completed work in JOURNAL.md.
- Run relevant checks before claiming a task is complete.

## Tools

Start with the least powerful tool that can safely complete the task. Prefer reversible changes and preserve user work.
EOF
    cat >"$workspace/TASKS.md" <<'EOF'
# Tasks

## Active

- [ ] Define the first concrete outcome.

## Waiting

## Completed
EOF
    cat >"$workspace/MEMORY.md" <<'EOF'
# Durable Memory

Store verified project facts and decisions here. Do not store secrets.
EOF
    cat >"$workspace/JOURNAL.md" <<'EOF'
# Work Journal

Record dated summaries of important work, checks, and remaining risks.
EOF
    cat >"$workspace/.env.example" <<'EOF'
# Variable names only. Never put real credentials in this file.
EOF
    cat >"$workspace/.gitignore" <<'EOF'
.env
*.key
*.pem
*.p12
*.p8
logs/
scratch/
EOF
    info "Created $workspace"
    info "Open it with: shadowfetch-agent-workspace open $name"

    if command -v hermes >/dev/null 2>&1; then
        read -r -p "Create an isolated Hermes profile for this workspace? [Y/n] " answer
        if [[ ! "$answer" =~ ^[Nn]$ ]]; then
            hermes profile create "$name" --description "Agent for $requested" || true
            hermes -p "$name" config set terminal.cwd "$workspace" || true
            info "Hermes profile '$name' is pointed at this workspace."
        fi
    fi
}

open_workspace() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: shadowfetch-agent-workspace open <name>"
    local workspace
    workspace="$ROOT/$(sanitize "$name")"
    [[ -d "$workspace" ]] || die "Workspace not found: $workspace"
    if command -v dolphin >/dev/null 2>&1; then
        dolphin "$workspace" >/dev/null 2>&1 &
    else
        printf '%s\n' "$workspace"
    fi
}

run_workspace() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: shadowfetch-agent-workspace run <name>"
    local safe workspace
    safe=$(sanitize "$name")
    workspace="$ROOT/$safe"
    [[ -d "$workspace" ]] || die "Workspace not found: $workspace"
    cd "$workspace"
    if command -v "$safe" >/dev/null 2>&1; then
        exec "$safe" chat
    elif command -v hermes >/dev/null 2>&1; then
        exec hermes -p "$safe" chat
    elif command -v openclaw >/dev/null 2>&1; then
        exec openclaw
    else
        die "Install an agent first with shadowfetch-agents."
    fi
}

menu() {
    say "Shadowfetch Agent Studio"
    info "Workspaces keep instructions, task state, artifacts and memory together."
    printf '\n  1) Create workspace\n  2) List workspaces\n  3) Open workspace folder\n  4) Run workspace agent\n  5) Agent health and security check\n  q) Quit\n\n'
    read -r -p "Choose: " choice
    case "$choice" in
        1) create_workspace ;;
        2) find "$ROOT" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' | sort ;;
        3) read -r -p "Workspace name: " name; open_workspace "$name" ;;
        4) read -r -p "Workspace name: " name; run_workspace "$name" ;;
        5) shadowfetch-agent-doctor ;;
        q|Q|"") exit 0 ;;
        *) die "Unknown choice." ;;
    esac
}

case "${1:-}" in
    create) create_workspace "${2:-}" ;;
    list) find "$ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort ;;
    open) open_workspace "${2:-}" ;;
    run) run_workspace "${2:-}" ;;
    "") menu ;;
    *) die "Usage: shadowfetch-agent-workspace [create|list|open|run] [name]" ;;
esac
