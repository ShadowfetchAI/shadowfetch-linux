#!/bin/bash
# Guided setup for agent browser, sandbox and orchestration capabilities.
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# began installing packages with apt. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-agent-tools - Guided setup for agent browser, sandbox and orchestration.

USAGE
  shadowfetch-agent-tools  walk through the optional capabilities

WHAT IT DOES
  INSTALLS PACKAGES with apt (for example chromium) for the capabilities
  you accept. Each step asks first.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-agent-tools (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

say() { printf '\n\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }

hermes_browser() {
    command -v hermes >/dev/null 2>&1 || { info "Install Hermes first with shadowfetch-hermes."; return 1; }
    say "Hermes browser and tool setup"
    info "The official tool setup lets you choose local Chromium, Camofox, or a cloud browser provider."
    exec hermes setup tools
}

openclaw_browser() {
    command -v openclaw >/dev/null 2>&1 || { info "Install OpenClaw first with shadowfetch-openclaw."; return 1; }
    if ! command -v chromium >/dev/null 2>&1; then
        info "A dedicated browser is required and is intentionally not baked into the ISO."
        read -r -p "Install Debian Chromium now? [Y/n] " answer
        if [[ ! "$answer" =~ ^[Nn]$ ]]; then
            sudo apt-get update
            sudo apt-get install -y chromium
        fi
    fi
    say "OpenClaw browser check"
    openclaw browser doctor || true
    info "Run 'openclaw browser start' after onboarding to open its isolated profile."
}

sandbox_check() {
    say "Container sandbox readiness"
    if command -v podman >/dev/null 2>&1; then
        podman info --format 'Podman {{.Version.Version}} · rootless={{.Host.Security.Rootless}}' || true
        info "Hermes can select the container terminal backend from 'hermes tools'."
        info "OpenClaw explains effective isolation with: openclaw sandbox explain"
    else
        info "Podman is missing. Install it with: sudo apt install podman"
    fi
}

case "${1:-}" in
    --hermes-browser) hermes_browser; exit ;;
    --openclaw-browser) openclaw_browser; exit ;;
    --doctor) exec shadowfetch-agent-doctor ;;
esac

say "Shadowfetch Agent Tools"
info "Enable only the capabilities you need. Browser profiles remain separate from your personal browser."
printf '\n  1) Configure Hermes tools and browser automation\n  2) Configure OpenClaw managed browser\n  3) Check container sandbox readiness\n  4) Run agent health and security audit\n  5) Open the Hermes local dashboard\n  q) Quit\n\n'
read -r -p "Choose: " choice
case "$choice" in
    1) hermes_browser ;;
    2) openclaw_browser ;;
    3) sandbox_check ;;
    4) shadowfetch-agent-doctor ;;
    5) command -v hermes >/dev/null 2>&1 && exec hermes dashboard || info "Install Hermes first." ;;
    q|Q|"") exit 0 ;;
    *) info "Unknown choice."; exit 1 ;;
esac
