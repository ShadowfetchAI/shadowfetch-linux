#!/bin/bash
# Safe, logged system update with preflight checks and Btrfs snapshot support.
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# ran the tool's normal actions. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-update - Safe, logged system update with preflight checks and Btrfs snapshots.

USAGE
  shadowfetch-update           apply updates
  shadowfetch-update --check   report what would change, change nothing

WHAT IT DOES
  Takes a Btrfs snapshot first where the layout supports it, so an update
  can be rolled back from the GRUB menu.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-update (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

MODE="apply"
[[ "${1:-}" == "--check" ]] && MODE="check"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch"
mkdir -p "$STATE_HOME"
LOG="$STATE_HOME/update-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG") 2>&1

say() { printf '\n\033[1;33m%s\033[0m\n' "$*"; }
ok() { printf '  \033[1;32mOK\033[0m  %s\n' "$*"; }
warn() { printf '  \033[1;31m!!\033[0m  %s\n' "$*"; }
die() { warn "$*"; printf '  Log: %s\n' "$LOG"; exit 1; }

say "Shadowfetch Safe Update"
printf '  Mode: %s\n  Log: %s\n' "$MODE" "$LOG"

free_kib=$(df -Pk / | awk 'NR==2 {print $4}')
(( free_kib >= 5 * 1024 * 1024 )) || die "At least 5 GiB of free system-disk space is required."
ok "Disk preflight passed ($((free_kib / 1024 / 1024)) GiB free)."

if command -v upower >/dev/null 2>&1; then
    battery=$(upower -e 2>/dev/null | grep -E '/battery(_|$)|/BAT[0-9]+$' | head -n1 || true)
    if [[ -n "$battery" ]]; then
        percentage=$(upower -i "$battery" 2>/dev/null | awk '/percentage:/ {gsub("%", "", $2); print int($2)}')
        state=$(upower -i "$battery" 2>/dev/null | awk '/state:/ {print $2}')
        if [[ -n "$percentage" && "$percentage" -lt 30 && "$state" == "discharging" ]]; then
            die "Battery is ${percentage}%. Connect power before a system update."
        fi
    fi
fi
ok "Power preflight passed."

curl -fsSIL --max-time 10 https://www.shadowfetch.com/linux/apt/dists/umbra/InRelease >/dev/null || die "The signed Shadowfetch update channel is unreachable."
ok "Update channel reachable."

if sudo fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then
    die "Another package operation is running. Close Discover or wait for it to finish."
fi

sudo dpkg --audit | tee /tmp/shadowfetch-dpkg-audit.$$ >/dev/null
[[ ! -s /tmp/shadowfetch-dpkg-audit.$$ ]] || die "The package database needs repair. Run: sudo dpkg --configure -a"
rm -f /tmp/shadowfetch-dpkg-audit.$$
ok "Package database is consistent."

say "Refreshing package information"
sudo apt-get update

if [[ "$MODE" == "check" ]]; then
    apt list --upgradable 2>/dev/null | sed '1d' || true
    printf '\nNo changes were made. Run shadowfetch-update without --check to install updates.\n'
    exit 0
fi

snapshot_id=""
if findmnt -n -o FSTYPE / | grep -qx btrfs && command -v snapper >/dev/null 2>&1 && sudo snapper -c root list >/dev/null 2>&1; then
    say "Creating a pre-update snapshot"
    snapshot_id=$(sudo snapper -c root create --type pre --print-number --description "Shadowfetch safe update $(date -Is)" || true)
    [[ -n "$snapshot_id" ]] && ok "Snapshot $snapshot_id created."
fi

say "Installing system updates"
sudo DEBIAN_FRONTEND=noninteractive apt-get \
    -o Dpkg::Options::="--force-confold" \
    -o APT::Get::Assume-Yes=true \
    full-upgrade

if command -v flatpak >/dev/null 2>&1; then
    say "Updating user applications"
    flatpak update --user -y || warn "One or more user applications could not be updated."
fi

if [[ -n "$snapshot_id" ]]; then
    sudo snapper -c root create --type post --pre-number "$snapshot_id" --description "Shadowfetch safe update complete" >/dev/null || true
fi

say "Post-update health check"
shadowfetch-health --quick || true

if [[ -f /var/run/reboot-required ]]; then
    warn "A restart is required to finish the update."
else
    ok "Update complete. No restart is currently required."
fi
printf '\nFull log: %s\n' "$LOG"
