#!/bin/bash
# shadowfetch-hermes - install, update, then launch Hermes Agent.
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# began downloading and running a remote installer. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-hermes - Install, update and launch the Hermes agent.

USAGE
  shadowfetch-hermes       install or update, then start Hermes

WHAT IT DOES
  DOWNLOADS AND RUNS the official Hermes installer from Nous Research.
  Runs on-device; cloud providers are optional and off by default.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-hermes (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

say()  { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '  \033[1;31m%s\033[0m %s\n' "--" "$*"; }

# ---------------------------------------------------------------------------
# Brand mark, traced from usr/share/icons/hicolor/scalable/apps/shadowfetch.svg
# (hexagon #D8A24A, dot #E8B65E, chevron). ANSI only: the ISO ships no ASCII-art
# renderer and Konsole has no kitty graphics protocol, so this needs nothing.
# ---------------------------------------------------------------------------
sf_logo() {
    local G D R
    if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
        case "${COLORTERM:-}" in
            truecolor|24bit) G=$'[38;2;216;162;74m'; D=$'[38;2;232;182;94m' ;;
            *)               G=$'[38;5;179m';        D=$'[38;5;222m' ;;
        esac
        R=$'[0m'
    else
        G=""; D=""; R=""
    fi
    printf '
'
    printf '   %s    /\    %s
' "$G" "$R"
    printf '   %s   /  \   %s
' "$G" "$R"
    printf '   %s  /    \  %s
' "$G" "$R"
    printf '   %s /  %s()%s  \ %s
' "$G" "$D" "$G" "$R"
    printf '   %s|        |%s
' "$G" "$R"
    printf '   %s| \    / |%s
' "$G" "$R"
    printf '   %s|  \  /  |%s
' "$G" "$R"
    printf '   %s \  \/  / %s
' "$G" "$R"
    printf '   %s  \    /  %s
' "$G" "$R"
    printf '   %s   \  /   %s
' "$G" "$R"
    printf '   %s    \/    %s
' "$G" "$R"
    printf '
'
    printf '     %sS H A D O W F E T C H%s
' "$G" "$R"
    printf '       %s%s%s
' "$D" "$1" "$R"
    printf '
'
}


SELF="${BASH_SOURCE[0]}"
if [[ ! -t 0 && -z "${SHADOWFETCH_AGENT_TERMINAL:-}" && -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    if command -v konsole >/dev/null 2>&1; then
        exec konsole --hold -e bash -lc "export SHADOWFETCH_AGENT_TERMINAL=1; exec '$SELF'"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec x-terminal-emulator -e bash -lc "export SHADOWFETCH_AGENT_TERMINAL=1; exec '$SELF'"
    elif command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal -- bash -lc "export SHADOWFETCH_AGENT_TERMINAL=1; exec '$SELF'; read -r -p 'Press Enter to close...'"
    fi
fi

export PATH="$HOME/.local/bin:$HOME/.hermes/bin:/usr/local/bin:$PATH"

sf_logo "Hermes Agent  ·  Nous Research"

install_with_official_installer() {
    say "Installing Hermes Agent with the official Nous Research installer..."
    curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash
}

install_with_pipx() {
    say "Falling back to pipx install..."
    if ! command -v pipx >/dev/null 2>&1; then
        if command -v sudo >/dev/null 2>&1; then
            sudo apt-get update
            sudo apt-get install -y pipx python3-venv
        else
            warn "pipx is missing and sudo is not available."
            return 1
        fi
    fi
    pipx install --force hermes-agent
    pipx ensurepath || true
}

if command -v hermes >/dev/null 2>&1; then
    say "Hermes Agent is installed. Updating to the latest available release..."
    hermes update || python3 -m pip install --user -U hermes-agent || true
else
    install_with_official_installer || install_with_pipx
fi

export PATH="$HOME/.local/bin:$HOME/.hermes/bin:/usr/local/bin:$PATH"

if ! command -v hermes >/dev/null 2>&1; then
    warn "Hermes did not land on PATH."
    info "Open a new terminal, or run: export PATH=\"\$HOME/.local/bin:\$HOME/.hermes/bin:\$PATH\""
    exit 1
fi

say "Opening Hermes setup. Choose Nous Portal, a cloud provider, or your local Ollama endpoint."
info "After setup, run 'hermes' to start chatting, or 'hermes gateway setup' for messaging."
exec hermes setup
