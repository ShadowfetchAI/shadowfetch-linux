#!/bin/bash

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# began downloading and running the Ollama installer. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-llm - Pick a Hugging Face model matched to your hardware and run it locally.

USAGE
  shadowfetch-llm          inspect the machine, suggest models, then fetch one

WHAT IT DOES
  Installs Ollama first if it is missing, by DOWNLOADING AND RUNNING the
  official installer. Model downloads are several GB; it checks free disk
  and asks before large ones.

Part of Shadowfetch Linux. https://shadowfetch.com/linux/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-llm (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac
# shadowfetch-llm - choose a Hugging Face model matched to YOUR hardware, run it locally via Ollama.
say()  { printf '\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
err()  { printf '\033[1;31m%s\033[0m\n' "$*"; }

# --- ensure Ollama (install + harden), serialized via a shared lock so two AI helpers can't race ---
if ! command -v ollama >/dev/null 2>&1; then
    say "Installing Ollama (local model runtime)..."
    (
        flock -w 600 9 2>/dev/null || { err "Could not acquire install lock."; exit 1; }
        command -v ollama >/dev/null 2>&1 && exit 0
        curl -fsSL https://ollama.com/install.sh | sh || exit 1
        sudo mkdir -p /etc/systemd/system/ollama.service.d
        printf '[Service]\nEnvironment="OLLAMA_HOST=127.0.0.1:11434"\n' | sudo tee /etc/systemd/system/ollama.service.d/10-localhost.conf >/dev/null
        sudo systemctl daemon-reload 2>/dev/null || true
        sudo systemctl restart ollama 2>/dev/null || true
        command -v ufw >/dev/null 2>&1 && sudo ufw deny 11434/tcp >/dev/null 2>&1 || true
    ) 9>/tmp/shadowfetch-ollama-install.lock
    command -v ollama >/dev/null 2>&1 || { err "Ollama install failed."; exit 1; }
fi

# --- detect hardware ---
RAM_GB=$(free -g 2>/dev/null | awk '/^Mem:/{print $2}'); [ -z "$RAM_GB" ] && RAM_GB=0
VRAM_GB=0; GPU=""
if command -v nvidia-smi >/dev/null 2>&1; then
    V=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc '0-9')
    [ -n "$V" ] && VRAM_GB=$((V/1024))
    [ "$VRAM_GB" -gt 0 ] && GPU="NVIDIA GPU ${VRAM_GB} GB VRAM"
fi
if [ "${VRAM_GB:-0}" -ge 6 ]; then BUDGET=$VRAM_GB; HW="$GPU"; else BUDGET=$RAM_GB; HW="CPU + ${RAM_GB} GB RAM${GPU:+ ($GPU - small for big models)}"; fi

# --- detect free disk where Ollama stores its models ---
DISK_DIR=/usr/share/ollama/.ollama/models
[ -d "$DISK_DIR" ] || DISK_DIR=/usr/share/ollama
[ -d "$DISK_DIR" ] || DISK_DIR=/
FREE_GB=$(df -BG --output=avail "$DISK_DIR" 2>/dev/null | tail -1 | tr -dc '0-9')
[ -z "$FREE_GB" ] && FREE_GB=$(df -BG / 2>/dev/null | tail -1 | awk '{print $4}' | tr -dc '0-9')
[ -z "$FREE_GB" ] && FREE_GB=0

cat <<'BANNER'

============================================
  Pick your local model  -  from Hugging Face
  100% private. Runs on your machine via Ollama.
============================================
BANNER
info "Detected hardware  : ${HW}"
info "Memory budget      : ~${BUDGET} GB usable for a model"
info "Free disk (models) : ~${FREE_GB} GB"
echo

# label | hf GGUF repo | approx download | RAM GB to run | download GB (numeric)
MODELS=(
  "Llama 3.2 1B   tiny, instant|bartowski/Llama-3.2-1B-Instruct-GGUF|~0.8 GB|3|1"
  "Llama 3.2 3B   light + quick|bartowski/Llama-3.2-3B-Instruct-GGUF|~2.0 GB|5|2"
  "Mistral 7B     fast classic|bartowski/Mistral-7B-Instruct-v0.3-GGUF|~4.4 GB|8|5"
  "Qwen 2.5 7B    strong at code/math|bartowski/Qwen2.5-7B-Instruct-GGUF|~4.7 GB|8|5"
  "Llama 3.1 8B   great all-rounder|bartowski/Meta-Llama-3.1-8B-Instruct-GGUF|~4.9 GB|9|5"
  "Qwen 2.5 14B   more capable|bartowski/Qwen2.5-14B-Instruct-GGUF|~9 GB|14|9"
  "Phi-4 14B      sharp reasoning|bartowski/phi-4-GGUF|~9 GB|14|9"
  "Qwen 2.5 32B   heavy|bartowski/Qwen2.5-32B-Instruct-GGUF|~20 GB|26|20"
  "Llama 3.1 70B  workstation-class|bartowski/Meta-Llama-3.1-70B-Instruct-GGUF|~43 GB|50|43"
)
# recommend: largest model that fits BOTH the memory budget AND free disk (+2 GB headroom)
REC=0; i=0
for m in "${MODELS[@]}"; do
    i=$((i+1)); need=$(echo "$m" | cut -d'|' -f4); dl=$(echo "$m" | cut -d'|' -f5)
    if [ "${BUDGET:-0}" -ge "$need" ] && [ "${FREE_GB:-0}" -ge $((dl+2)) ]; then REC=$i; fi
done
[ "$REC" -eq 0 ] && REC=1
info "Recommended for your machine: option ${REC}"
echo
i=0
for m in "${MODELS[@]}"; do
    i=$((i+1))
    label=$(echo "$m" | cut -d'|' -f1); size=$(echo "$m" | cut -d'|' -f3); need=$(echo "$m" | cut -d'|' -f4); dl=$(echo "$m" | cut -d'|' -f5)
    if [ "${BUDGET:-0}" -lt "$need" ]; then fit="\033[1;31mneeds ${need}GB RAM\033[0m"
    elif [ "${FREE_GB:-0}" -lt $((dl+2)) ]; then fit="\033[1;31mneeds ${dl}GB disk\033[0m"
    else fit="\033[1;32mfits\033[0m"; fi
    star=""; [ "$i" -eq "$REC" ] && star=" \033[1;33m<- recommended\033[0m"
    printf "  %d) %-34s %-8s  %b%b\n" "$i" "$label" "$size" "$fit" "$star"
done
echo "  c) Enter ANY Hugging Face GGUF repo yourself  (e.g. TheBloke/...-GGUF)"
echo "  q) Quit"
echo
printf "Choice [%d]: " "$REC"; read choice
[ -z "$choice" ] && choice=$REC
DL=0
case "$choice" in
    q|Q) exit 0 ;;
    c|C) printf "Hugging Face repo (user/name): "; read repo
         repo="${repo#hf.co/}"; repo="${repo#https://huggingface.co/}"; repo="${repo%/}"
         [ -z "$repo" ] && { err "No repo entered."; exit 1; } ;;
    *) if echo "$choice" | grep -qE '^[0-9]+$' && [ "$choice" -ge 1 ] && [ "$choice" -le "${#MODELS[@]}" ]; then
           repo=$(echo "${MODELS[$((choice-1))]}" | cut -d'|' -f2)
           DL=$(echo "${MODELS[$((choice-1))]}" | cut -d'|' -f5)
       else err "Invalid choice."; exit 1; fi ;;
esac

# --- disk preflight: warn + confirm if it won't fit, and gate very large models ---
if [ "${DL:-0}" -gt 0 ] 2>/dev/null && [ "${FREE_GB:-0}" -lt $((DL+2)) ]; then
    err "Low disk: this model needs ~${DL} GB (plus headroom) but only ~${FREE_GB} GB is free where Ollama stores models."
    printf "Download anyway? [y/N] "; read yn
    case "$yn" in y|Y) ;; *) info "Cancelled - pick a smaller model or free up disk space."; exit 0 ;; esac
elif [ "${DL:-0}" -ge 20 ] 2>/dev/null; then
    info "Heads up: this is a large model (~${DL} GB download, needs plenty of RAM to run)."
    printf "Continue? [y/N] "; read yn
    case "$yn" in y|Y) ;; *) info "Cancelled."; exit 0 ;; esac
fi

say "Pulling + starting  hf.co/${repo}"
info "First run downloads the model, then you chat locally. Type  /bye  to exit."
exec ollama run "hf.co/${repo}"
