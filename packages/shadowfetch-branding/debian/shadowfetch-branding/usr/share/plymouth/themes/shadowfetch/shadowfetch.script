# Shadowfetch Linux Plymouth boot splash (Umbra v2).
# Graphite ink background, centered emblem, warm gold scanner dots.

Window.SetBackgroundTopColor(0.039, 0.051, 0.067);     # #0a0d11 ink
Window.SetBackgroundBottomColor(0.055, 0.071, 0.094);  # #0e1218 slight gradient

# --- Emblem ---
logo.image = Image("logo.png");
logo_max = 320;
if (logo.image.GetWidth() > logo_max) {
    scale = logo_max / logo.image.GetWidth();
    logo.image = logo.image.Scale(logo_max, logo.image.GetHeight() * scale);
}
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# --- Wordmark (warm off-white) ---
brand.image = Image.Text("SHADOWFETCH  LINUX", 0.90, 0.86, 0.74, 1, "Sans Bold 14");
brand.sprite = Sprite(brand.image);
brand.x = Window.GetWidth() / 2 - brand.image.GetWidth() / 2;
brand.y = logo.y + logo.image.GetHeight() + 24;
brand.sprite.SetPosition(brand.x, brand.y, 0);

# --- Gold scanner dots ---
dot_count = 7;
dot_size  = 24;
dot_gap   = 14;
dot_image = Image("dot-gold.png");
dots_width = dot_count * dot_size + (dot_count - 1) * dot_gap;
dots_x0 = Window.GetWidth() / 2 - dots_width / 2;
dots_y  = brand.y + brand.image.GetHeight() + 28;

for (i = 0; i < dot_count; i++) {
    dots[i].image  = dot_image;
    dots[i].sprite = Sprite(dots[i].image);
    dots[i].sprite.SetPosition(dots_x0 + i * (dot_size + dot_gap), dots_y, 0);
    dots[i].sprite.SetOpacity(0.40);
}

fun refresh_callback() {
    t = Plymouth.GetTime();
    pos = (t * 2.5) % dot_count;
    for (i = 0; i < dot_count; i++) {
        d = pos - i;
        if (d < 0) d = -d;
        if (d > dot_count / 2) d = dot_count - d;
        op = 1.0 - (d / (dot_count / 2));
        if (op < 0.40) op = 0.40;
        dots[i].sprite.SetOpacity(op);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

status.sprite = Sprite();
fun message_callback(text) {
    msg = Image.Text(text, 0.60, 0.62, 0.68, 1, "Sans 10");
    status.sprite.SetImage(msg);
    status.sprite.SetPosition(
        Window.GetWidth() / 2 - msg.GetWidth() / 2,
        dots_y + 32,
        0
    );
}
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetUpdateStatusFunction(message_callback);
