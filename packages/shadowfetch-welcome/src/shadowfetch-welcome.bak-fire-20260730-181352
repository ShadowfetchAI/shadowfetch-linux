class WiFiPage(QWidget):
    """Step 3: get the user online so apps/drivers/updates can install."""
    def __init__(self, on_next):
        super().__init__()
        self._on_next = on_next
        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 44, 48, 36)
        lay.setSpacing(14)
        lay.addWidget(_label("Connect to the internet", 22, TEXT, bold=True))
        lay.addWidget(_label(
            "A connection lets you install apps, drivers and updates now. Wired connections "
            "work automatically - for Wi-Fi, open the settings below. You can also continue "
            "and connect later.", 12, MUTED, wrap=True))
        lay.addSpacing(6)
        card = Card()
        cl = QVBoxLayout(card)
        cl.setContentsMargins(20, 18, 20, 18)
        cl.setSpacing(12)
        self.status = _label("Checking connection...", 13, MUTED)
        cl.addWidget(self.status)
        brow = QHBoxLayout()
        wifi_btn = QPushButton("Open Wi-Fi settings")
        wifi_btn.setFixedHeight(40)
        wifi_btn.clicked.connect(self._open_wifi)
        recheck = QPushButton("Re-check")
        recheck.setFixedHeight(40)
        recheck.clicked.connect(self._check)
        brow.addWidget(wifi_btn)
        brow.addWidget(recheck)
        brow.addStretch(1)
        cl.addLayout(brow)
        lay.addWidget(card)
        lay.addStretch(1)
        nxt = QPushButton("Continue  →")
        nxt.setFixedHeight(44)
        nxt.clicked.connect(self._on_next)
        lay.addWidget(nxt, alignment=Qt.AlignmentFlag.AlignRight)
        self._check()

    def _check(self):
        online = False
        try:
            r = subprocess.run(["nmcli", "-t", "-f", "CONNECTIVITY", "general", "status"],
                               capture_output=True, text=True, timeout=5)
            online = "full" in (r.stdout or "").lower()
        except Exception:  # noqa: BLE001
            online = False
        if online:
            self.status.setText("Connected - you're online.")
            self.status.setStyleSheet(f"color: {GOLD}; background: transparent;")
        else:
            self.status.setText("Not connected yet. Open Wi-Fi settings to join a network, "
                                "or continue and connect later.")
            self.status.setStyleSheet(f"color: {MUTED}; background: transparent;")

    def _open_wifi(self):
        for cmd in (["kcmshell6", "kcm_networkmanagement"],
                    ["nm-connection-editor"],
                    ["plasmawindowed", "org.kde.plasma.networkmanagement"]):
            if shutil.which(cmd[0]):
                try:
                    subprocess.Popen(cmd)
                    return
                except Exception:  # noqa: BLE001
                    continue


class GraphicsPage(QWidget):
    """Step 4: detect the GPU; offer one-click NVIDIA driver setup."""
    def __init__(self, on_next):
        super().__init__()
        self._on_next = on_next
        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 44, 48, 36)
        lay.setSpacing(14)
        lay.addWidget(_label("Graphics drivers", 22, TEXT, bold=True))
        gpu = self._detect()
        card = Card()
        cl = QVBoxLayout(card)
        cl.setContentsMargins(20, 18, 20, 18)
        cl.setSpacing(10)
        if gpu == "nvidia":
            cl.addWidget(_label("NVIDIA graphics detected", 14, GOLD, bold=True))
            cl.addWidget(_label(
                "Install the recommended NVIDIA driver for full performance, smooth video and "
                "external displays. We detect your exact card and pick the right driver - it opens "
                "in a terminal and asks before changing anything.", 12, MUTED, wrap=True))
            btn = QPushButton("Install GPU drivers")
            btn.setFixedHeight(42)
            btn.clicked.connect(self._launch_gpu)
            cl.addWidget(btn, alignment=Qt.AlignmentFlag.AlignLeft)
        else:
            label = {"amd": "AMD", "intel": "Intel"}.get(gpu, "Your")
            cl.addWidget(_label(f"{label} graphics - open-source drivers active", 14, GOLD, bold=True))
            cl.addWidget(_label(
                "The built-in open-source drivers already give you full acceleration, Vulkan and "
                "hardware video decoding. Nothing to install.", 12, MUTED, wrap=True))
        lay.addWidget(card)
        lay.addStretch(1)
        nxt = QPushButton("Continue  →")
        nxt.setFixedHeight(44)
        nxt.clicked.connect(self._on_next)
        lay.addWidget(nxt, alignment=Qt.AlignmentFlag.AlignRight)

    def _detect(self):
        try:
            out = subprocess.run(["lspci"], capture_output=True, text=True, timeout=5).stdout
        except Exception:  # noqa: BLE001
            return "unknown"
        low = "\n".join(l for l in out.splitlines()
                        if any(k in l for k in ("VGA", "3D", "Display"))).lower()
        if "nvidia" in low:
            return "nvidia"
        if any(k in low for k in ("amd", "ati", "radeon")):
            return "amd"
        if "intel" in low:
            return "intel"
        return "unknown"

    def _launch_gpu(self):
        term = shutil.which("konsole") or shutil.which("x-terminal-emulator")
        if term:
            try:
                subprocess.Popen([term, "-e", "bash", "-lc",
                                  "shadowfetch-gpu; echo; read -p 'Press Enter to close...'"])
            except Exception:  # noqa: BLE001
                pass


class AccentSwatch(QWidget):
    """A colour chip with the name underneath - label never clips."""
    clicked = pyqtSignal(str, str)

    def __init__(self, name, hexc):
        super().__init__()
        self.name = name
        self.hexc = hexc
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(8)
        self.chip = QFrame()
        self.chip.setFixedSize(96, 56)
        self.lab = _label(name, 11, MUTED)
        self.lab.setAlignment(Qt.AlignmentFlag.AlignHCenter)
        v.addWidget(self.chip, alignment=Qt.AlignmentFlag.AlignHCenter)
        v.addWidget(self.lab)
        self.set_selected(False)

    def set_selected(self, sel):
        border = f"3px solid {TEXT}" if sel else f"1px solid {BORDER}"
        self.chip.setStyleSheet(
            f"background-color: {self.hexc}; border: {border}; border-radius: 10px;"
        )
        weight = "700" if sel else "400"
        self.lab.setStyleSheet(
            f"color: {GOLD if sel else MUTED}; background: transparent; font-weight: {weight};"
        )

    def mousePressEvent(self, ev):
        self.clicked.emit(self.name, self.hexc)


