#!/usr/bin/env python3
"""
shadowfetch-welcome - first-boot welcome & setup for Shadowfetch Linux (Umbra).

A small, focused PyQt6 wizard that:
  - Welcomes the user to Shadowfetch Linux
  - Lets them choose a role-based setup profile to preselect useful apps
  - Lets them pick a signature accent colour (applied to KDE Plasma 6)
  - Offers a curated set of optional apps to install from Flathub
  - Offers to set up the private, local AI stack (Ollama + Open-WebUI)

Honest, fast, private, AI-ready - built on Debian + KDE Plasma 6.
Everything here is reliable on Plasma 6; nothing is left half-working.
"""

import sys
import shutil
import subprocess
from pathlib import Path

# --help and --version are answered here, before the PyQt6 import and before any
# other work happens.
#
# Two reasons for this position. First, this program is the first-boot wizard,
# and until now its only flag was --force - so `shadowfetch-welcome --version`
# fell straight through to QApplication and opened the setup flow that offers to
# install Flathub apps and the local AI stack. Asking a program what it is must
# never start an installer.
#
# Second, answering above the import means both flags still work on a machine
# where PyQt6 is missing or broken, which is precisely when someone is most
# likely to be asking which version they are running.
if __name__ == "__main__" and {"-h", "--help", "--version"}.intersection(sys.argv[1:]):
    # The same file every other shadowfetch command reports from, read at run
    # time rather than compiled in, so this can never drift from the system it
    # is running on. "unknown" is honest; a number that might be wrong is not.
    _vfile = Path("/usr/share/shadowfetch/version")
    _ver = _vfile.read_text().strip() if _vfile.is_file() else "unknown"
    if "--version" in sys.argv[1:]:
        print(f"shadowfetch-welcome (Shadowfetch Linux) {_ver}")
    else:
        print(
            "shadowfetch-welcome - first-boot welcome and setup for Shadowfetch Linux\n"
            "\n"
            "Usage: shadowfetch-welcome [OPTION]\n"
            "\n"
            "A graphical wizard that runs once on first login. It offers a role-based\n"
            "setup profile, a Plasma accent colour, a curated set of Flathub apps, and\n"
            "optional setup of the local AI stack (Ollama and Open-WebUI).\n"
            "\n"
            "Options:\n"
            "  --force        Run again even though setup has already been completed.\n"
            "  -h, --help     Show this message and exit.\n"
            "  --version      Show the Shadowfetch Linux version and exit.\n"
            "\n"
            "With no options it exits silently if setup has already been completed, and\n"
            "otherwise opens the wizard. Installing anything is opt-in and confirmed\n"
            "inside the wizard; no option here installs software on its own."
        )
    raise SystemExit(0)

