        # Pick-your-own model from Hugging Face (hardware-matched)
        llm_card = Card()
        llm_row = QHBoxLayout(llm_card)
        llm_row.setContentsMargins(16, 14, 16, 14)
        self.llm_cb = QCheckBox()
        llm_text = QVBoxLayout()
        llm_text.setSpacing(2)
        llm_text.addWidget(_label("Advanced: choose a different local model", 13, GOLD, bold=True))
        llm_text.addWidget(_label(
            "Optional model catalog for experienced users. Skip this unless you already know "
            "you need a specific model or GGUF repository.",
            11, MUTED, wrap=True,
        ))
        llm_row.addWidget(self.llm_cb, 0, Qt.AlignmentFlag.AlignTop)
        llm_row.addLayout(llm_text, 1)
        vbox.addWidget(llm_card)

        # Curated apps
        for app_id, name, desc in APPS:
            if not app_id:  # section header row
                vbox.addSpacing(8)
                vbox.addWidget(_label(name, 13, GOLD, bold=True))
                continue
            card = Card()
            row = QHBoxLayout(card)
            row.setContentsMargins(16, 12, 16, 12)
            cb = QCheckBox()
            txt = QVBoxLayout()
            txt.setSpacing(2)
            txt.addWidget(_label(name, 13, TEXT, bold=True))
            txt.addWidget(_label(desc, 11, MUTED, wrap=True))
            row.addWidget(cb, 0, Qt.AlignmentFlag.AlignTop)
            row.addLayout(txt, 1)
            self.checks.append((cb, app_id))
            self.check_by_id[app_id] = cb
            vbox.addWidget(card)

        vbox.addStretch(1)
        scroll.setWidget(container)
        lay.addWidget(scroll, 1)

        nxt = QPushButton("Continue  →")
        nxt.setFixedHeight(44)
        nxt.clicked.connect(self._submit)
        lay.addWidget(nxt, alignment=Qt.AlignmentFlag.AlignRight)
        self._on_next = on_next

    def _submit(self):
        flatpaks = [app for cb, app in self.checks if cb.isChecked()]
        self._on_next(flatpaks, self.ai_cb.isChecked(), self.llm_cb.isChecked())

    def apply_profiles(self, profile_keys):
        if not profile_keys:
            self.profile_hint.setText("No preset selected. Choose any apps or AI options you want.")
            return
        names = []
        app_ids = set()
        ai = False
        llm = False
        for key in profile_keys:
            preset = PROFILE_BY_KEY.get(key)
            if not preset:
                continue
            names.append(preset["title"])
            app_ids.update(preset["apps"])
            ai = ai or preset["ai"]
            llm = llm or preset["llm"]
        for app_id, cb in self.check_by_id.items():
            if app_id in app_ids:
                cb.setChecked(True)
        if ai:
            self.ai_cb.setChecked(True)
        if llm:
            self.llm_cb.setChecked(True)
        self.profile_hint.setText("Preset selections applied: " + ", ".join(names) + ". Adjust anything before continuing.")


