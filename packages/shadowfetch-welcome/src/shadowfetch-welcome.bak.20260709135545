# ---- helpers -------------------------------------------------------------
def _font(size: int, bold: bool = False) -> QFont:
    f = QFont()
    f.setPointSize(size)
    f.setBold(bold)
    return f


def _label(text: str, size: int, colour: str, bold: bool = False, wrap: bool = False) -> QLabel:
    lab = QLabel(text)
    lab.setFont(_font(size, bold))
    lab.setStyleSheet(f"color: {colour}; background: transparent;")
    lab.setWordWrap(wrap)
    lab.setTextFormat(Qt.TextFormat.PlainText)  # never render markup literally
    return lab


class CommandWorker(QThread):
    """Run a list of argv commands off the UI thread."""
    progress = pyqtSignal(str)
    finished = pyqtSignal(int)

    def __init__(self, commands):
        super().__init__()
        self.commands = commands

    def run(self):
        rc = 0
        for cmd in self.commands:
            self.progress.emit(cmd[0] + " ...")
            try:
                r = subprocess.run(cmd, capture_output=True, text=True)
                if r.returncode != 0:
                    rc = r.returncode
                    msg = (r.stderr or r.stdout).strip().splitlines()
                    self.progress.emit("  ! " + (msg[-1][:160] if msg else "failed"))
            except FileNotFoundError:
                rc = 1
                self.progress.emit(f"  ! {cmd[0]} not found")
            except Exception as e:  # noqa: BLE001 - best effort, keep going
                rc = 1
                self.progress.emit(f"  ! {e}")
        self.finished.emit(rc)


