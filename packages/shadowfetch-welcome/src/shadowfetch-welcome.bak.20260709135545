            card = Card()
            row = QHBoxLayout(card)
            row.setContentsMargins(16, 12, 16, 12)
            rb = QRadioButton()
            rb.setChecked(key == "none")
            rb.toggled.connect(lambda checked, k=key: self._set(k) if checked else None)
            self.group.addButton(rb)
            txt = QVBoxLayout()
            txt.setSpacing(2)
            txt.addWidget(_label(name, 13, GOLD if key != "none" else TEXT, bold=True))
            txt.addWidget(_label(desc, 11, MUTED, wrap=True))
            row.addWidget(rb, 0, Qt.AlignmentFlag.AlignTop)
            row.addLayout(txt, 1)
            lay.addWidget(card)
        lay.addStretch(1)
        nxt = QPushButton("Continue  →")
        nxt.setFixedHeight(44)
        nxt.clicked.connect(lambda: self._on_next(self.agent))
        lay.addWidget(nxt, alignment=Qt.AlignmentFlag.AlignRight)

    def _set(self, key):
        self.agent = key


class InstallPage(QWidget):
    def __init__(self, on_close):
        super().__init__()
        self.on_close = on_close
        self.setup_ai = False
        self.setup_llm = False
        self.agent = "none"

        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 48, 48, 40)
        lay.setSpacing(16)

        self.title = _label("Setting things up…", 22, TEXT, bold=True)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        self.log = _label("", 11, MUTED, wrap=True)

        lay.addWidget(self.title)
        lay.addWidget(self.bar)
        lay.addWidget(self.log)
        lay.addStretch(1)

        self.done_btn = QPushButton("Finish")
        self.done_btn.setFixedHeight(44)
        self.done_btn.setEnabled(False)
        self.done_btn.clicked.connect(self._finish)
        lay.addWidget(self.done_btn, alignment=Qt.AlignmentFlag.AlignRight)

    def start(self, accent_name, accent_hex, flatpak_ids, setup_ai, setup_llm, agent):
        self.setup_ai = setup_ai
        self.setup_llm = setup_llm
        self.agent = agent
        (CONFIG_DIR / "accent").write_text(f"{accent_name}\n{accent_hex}\n")

        commands = [
            ["kwriteconfig6", "--file", "kdeglobals", "--group", "General",
             "--key", "AccentColor", _rgb(accent_hex)],
        ]
        if flatpak_ids:
            commands.append(["flatpak", "remote-add", "--user", "--if-not-exists",
                             "flathub", FLATHUB_URL])
            for fid in flatpak_ids:
                commands.append(["flatpak", "install", "-y", "--user", "flathub", fid])

        self.worker = CommandWorker(commands)
        self.worker.progress.connect(self.log.setText)
        self.worker.finished.connect(self._on_done)
        self.worker.start()

    def _on_done(self, rc):
        self.title.setText("All set." if rc == 0 else "Done (with minor warnings).")
        self.bar.setRange(0, 1)
        self.bar.setValue(1)
        if self.setup_ai or self.setup_llm or self.agent != "none":
            self.log.setText("Click Finish to open the selected setup(s) in the terminal.")
        self.done_btn.setEnabled(True)

    def _finish(self):
        WELCOME_DONE_FLAG.touch()
        term = shutil.which("konsole") or shutil.which("x-terminal-emulator")
        if term:
            cmds = []
            if self.setup_ai:
                cmds.append("shadowfetch-ai setup")
            if self.setup_llm:
                cmds.append("shadowfetch-llm")
            if self.agent == "hermes":
                cmds.append("shadowfetch-hermes")
            elif self.agent == "openclaw":
                cmds.append("shadowfetch-openclaw")
            if cmds:
                self._launch(term, "; ".join(cmds))
        self.on_close()

    def _launch(self, term, cmd):
        try:
            subprocess.Popen([term, "-e", "bash", "-c",
                              f"{cmd}; echo; read -p 'Press Enter to close...'"])
        except Exception:  # noqa: BLE001
            pass


class ShadowfetchWelcome(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Shadowfetch Linux - Welcome")
        self.setMinimumSize(QSize(820, 600))
        self.setStyleSheet(f"""
            QMainWindow {{ background-color: {BG}; }}
            QWidget {{ color: {TEXT}; }}
            QLabel {{ background: transparent; }}
            QCheckBox {{ spacing: 10px; }}
            QCheckBox::indicator {{ width: 18px; height: 18px; }}
            QPushButton {{
                background-color: {GOLD}; color: {INK};
                font-weight: 700; padding: 11px 26px;
                border: none; border-radius: 8px;
            }}
            QPushButton:hover {{ background-color: {GOLD_HOVER}; }}
            QPushButton:pressed {{ background-color: {GOLD_PRESS}; }}
            QPushButton:disabled {{ background-color: #333a44; color: #6b727b; }}
            QProgressBar {{
                border: 1px solid {BORDER}; border-radius: 5px;
                background: #11161e; height: 10px; text-align: center; color: {MUTED};
            }}
            QProgressBar::chunk {{ background-color: {GOLD}; border-radius: 5px; }}
            QScrollArea {{ background: transparent; border: none; }}
            QScrollBar:vertical {{ background: transparent; width: 10px; margin: 2px; }}
            QScrollBar::handle:vertical {{ background: {BORDER}; border-radius: 5px; min-height: 24px; }}
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
        """)

        self.accent_name = ACCENTS[0][0]
        self.accent_hex = ACCENTS[0][1]
        self.flatpaks = []
        self.setup_ai = False
        self.setup_llm = False

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        # Streamlined flow: Welcome -> Wi-Fi -> Graphics -> Accent -> Apps -> AI agent -> Install
        self.welcome = WelcomePage(lambda: self.stack.setCurrentIndex(1))
        self.wifi = WiFiPage(lambda: self.stack.setCurrentIndex(2))
        self.graphics = GraphicsPage(lambda: self.stack.setCurrentIndex(3))
        self.accent = AccentPage(self._got_accent)
        self.apps = AppsPage(self._got_apps)
        self.agent = AgentPage(self._got_agent)
        self.install = InstallPage(self.close)

        for w in (self.welcome, self.wifi, self.graphics, self.accent,
                  self.apps, self.agent, self.install):
            self.stack.addWidget(w)

    def _got_accent(self, name, hexc):
        self.accent_name, self.accent_hex = name, hexc
        self.stack.setCurrentIndex(4)

    def _got_apps(self, flatpaks, setup_ai, setup_llm):
        self.flatpaks = flatpaks
        self.setup_ai = setup_ai
        self.setup_llm = setup_llm
        self.stack.setCurrentIndex(5)

    def _got_agent(self, agent):
        self.stack.setCurrentIndex(6)
        self.install.start(self.accent_name, self.accent_hex, self.flatpaks,
                           self.setup_ai, self.setup_llm, agent)


def main():
    if WELCOME_DONE_FLAG.exists() and "--force" not in sys.argv:
        return 0
    app = QApplication(sys.argv)
    app.setApplicationName("Shadowfetch Welcome")
    win = ShadowfetchWelcome()
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
