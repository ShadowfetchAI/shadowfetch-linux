def _rgb(hex_colour: str) -> str:
    """'#D8A24A' -> '216,162,74' for Plasma's kdeglobals AccentColor."""
    h = hex_colour.lstrip("#")
    return f"{int(h[0:2], 16)},{int(h[2:4], 16)},{int(h[4:6], 16)}"


