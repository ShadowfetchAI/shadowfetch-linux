#!/bin/sh
# Shadowfetch Linux — live-build configuration
# This is the main config script live-build runs to set up the build.

set -e

lb config noauto \
    --mode debian \
    --initsystem systemd \
    --distribution testing \
    `# 2.1.2: chroot and bootstrap pinned to a snapshot so a rebuild reproduces` \
    `# the same package set. "testing" moves daily -- rebuilding 2.1.1 today does` \
    `# not give 2.1.1, and forky has already dropped network-manager-gnome, which` \
    `# this list declares, so an unpinned build now simply aborts.` \
    --mirror-chroot "https://snapshot.debian.org/archive/debian/20260726T000000Z/" \
    --mirror-chroot-security "https://snapshot.debian.org/archive/debian/20260726T000000Z/" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer false \
    --debian-installer-gui false \
    --architectures amd64 \
    --linux-flavours amd64 \
    --binary-images iso \
    --compression xz \
    --iso-application "Shadowfetch Linux" \
    --iso-publisher "Shadowfetch Project" \
    --iso-volume "SHADOWFETCH" \
    --bootappend-live "boot=live components username=shadow hostname=shadowfetch quiet splash" \
    --bootloader grub2 \
    --memtest none \
    --win32-loader false \
    --apt-recommends true \
    --apt-source-archives false \
    --backports false \
    --security false \
    --mirror-bootstrap "https://snapshot.debian.org/archive/debian/20260726T000000Z/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --firmware-chroot true \
    --firmware-binary true \
    "${@}"

# ---------------------------------------------------------------------------
# 2.1.2 NOTE, kept here on purpose.
#
# The snapshot pin above needs one companion setting that cannot be passed to
# `lb config`:
#
#     config/common:  APT_OPTIONS="--yes -o Acquire::Check-Valid-Until=false"
#
# Snapshot Release files carry a Valid-Until (this snapshot expires 2026-08-01)
# and an expired Release is a hard apt failure, so the check has to be relaxed
# for the build.
#
# It must NOT be moved to config/chroot_apt/apt.conf. That file is copied into
# the chroot by lb_binary and ends up inside the squashfs, which would ship a
# build-time workaround onto every user's installed system -- permanently
# disabling an integrity check on their machine to solve a problem we have on
# ours.
#
# This note is here rather than in config/common because `lb config` regenerates
# config/common from a template: it carries variable values forward but strips
# added comments. Verified 2026-07-30 -- the original comment was deleted by the
# first config run while the value survived.
# ---------------------------------------------------------------------------
